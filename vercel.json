{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd platform/frontend && npm install && npm run build && mkdir -p out && cp -r platform/frontend/dist/* out/",
  "outputDirectory": "out",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://YOUR-RAILWAY-APP.up.railway.app/api/$1" },
    { "source": "/assets/(.*)", "destination": "https://YOUR-RAILWAY-APP.up.railway.app/assets/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
