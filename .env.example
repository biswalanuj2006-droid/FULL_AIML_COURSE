# ---- Backend ----
# SQLite (default, zero-config) or PostgreSQL (Recommended on Railway/Render)
DATABASE_URL=sqlite:///./platform.db
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Secret for JWT signing - ALWAYS set this in production
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated allowed origins for the API (frontend dev server included)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Where course assets (Images/, Videos/, diagrams/) are served from.
# Defaults to the repo root - set to /app in Docker.
ASSETS_DIR=

# Built SPA location. Defaults to platform/frontend/dist.
FRONTEND_DIST=

# ---- Optional LLM upgrade for the AI tutor (it works without any key) ----
# Any ONE of these upgrades chat answers from the built-in engine to an LLM:
OPENROUTER_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# ---- Frontend (only for split static hosting on Vercel/Netlify) ----
# VITE_API_BASE=https://your-app.up.railway.app
